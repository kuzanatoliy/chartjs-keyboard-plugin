{
  "name": "@kuzanatoliorg/chartjs-keyboard-plugin",
  "version": "0.0.0",
  "private": false,
  "description": "Chartjs keyboard navigation plugin",
  "keywords": [
    "chartjs",
    "a11y",
    "keyboard novigation"
  ],
  "homepage": "https://github.com/kuzanatoliy/chartjs-keyboard-plugin#readme",
  "bugs": {
    "url": "https://github.com/kuzanatoliy/chartjs-keyboard-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuzanatoliy/chartjs-keyboard-plugin.git"
  },
  "license": "MIT",
  "author": "kuzanatoliy <njkznu@gmail.com>",
  "type": "module",
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build": "npm run build:esm & npm run build:cjs",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "commitlint": "commitlint --edit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@kuzanatoliorg/commitlint-config": "^1.4.0",
    "@kuzanatoliorg/prettier-config": "^1.16.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/esm/index.d.cts",
        "default": "./dist/esm/index.cjs"
      }
    }
  }
}
